NODE_ENV=development
PORT=3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# JWT: use a long random secret in production
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Cookies
COOKIE_SECURE=false

# Comma-separated origins. In Render use your public HTTPS URL.
CORS_ORIGIN=http://localhost:3000

# Optional
TRUST_PROXY=true
